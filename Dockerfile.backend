# --- Build stage ---
FROM node:20-alpine

# Configurer pnpm pour qu'il fonctionne correctement dans Docker
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm config set store-dir /root/.pnpm-store

# Créer le répertoire de l'application
WORKDIR /app

# Copier uniquement les fichiers de configuration des dépendances
COPY package.json pnpm-lock.yaml ./

# Installer les dépendances
RUN pnpm install --frozen-lockfile --shamefully-hoist

# Copier le reste du code source
COPY . .

# Ajouter TypeScript comme dépendance de développement
RUN pnpm add -D typescript

# S'assurer que le dossier dist est vide avant de compiler
RUN rm -rf dist || true && mkdir -p dist

# Compiler le code TypeScript
RUN pnpm build

# Exposer le port de l'API
EXPOSE 5000

# Commande par défaut pour exécuter l'application
CMD ["pnpm", "start"]